<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_three_stage_lock.xml
    Full-screen overlay for the Three-Stage IQ Unlock flow.
    One FrameLayout with multiple panels; only one is VISIBLE at a time.
    Transitions are animated in ThreeStageLockActivity.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ═══════════════════════════════════════════════════════════════════════
         PANEL: STAGE 1 / STAGE 2  (shared layout, content swapped in code)
         ══════════════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/panelQuestion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Top bar: locked app label + close -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLockedAppIconQ"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Locked app icon"
                    tools:src="@android:drawable/sym_def_app_icon" />

                <TextView
                    android:id="@+id/tvLockedAppNameQ"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:alpha="0.7"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    tools:text="Instagram is locked" />

                <ImageButton
                    android:id="@+id/btnCloseQ"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#66FFFFFF" />
            </LinearLayout>

            <!-- Stage progress: 3 pill steps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/stepDot1"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_active"
                    android:tag="step1" />

                <View
                    android:id="@+id/stepDot2"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_inactive"
                    android:tag="step2" />

                <View
                    android:id="@+id/stepDot3"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_inactive"
                    android:tag="step3" />
            </LinearLayout>

            <!-- Stage badge: "CHALLENGE I" / "CHALLENGE II" -->
            <TextView
                android:id="@+id/tvStageBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_stage_badge"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="#7C4DFF"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium"
                tools:text="CHALLENGE I — LOGICAL DEDUCTION" />

            <!-- Timer circular arc -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="16dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/timerProgress"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    app:indicatorColor="#7C4DFF"
                    app:trackColor="#2A2A2A"
                    app:trackThickness="5dp"
                    app:indicatorSize="72dp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="90" />
            </FrameLayout>

            <!-- Question card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvQuestionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUESTION"
                        android:textColor="#7C4DFF"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="#EEEEEE"
                        android:textSize="16sp"
                        tools:text="If 5 machines take 5 minutes to make 5 widgets, how many minutes would it take 100 machines to make 100 widgets?" />

                    <!-- Hint (shown after 45s or wrong answer) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#110E1C"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#3D2D6B"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💡"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="#B39DDB"
                                android:textSize="13sp"
                                tools:text="Each machine works independently." />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wrong answer feedback (inline, appears briefly) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWrongQ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1A0808"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#5C1010"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvWrongFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="14dp"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    tools:text="✗ Incorrect. 1 attempt remaining." />
            </com.google.android.material.card.MaterialCardView>

            <!-- Answer input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Your answer"
                app:boxBackgroundColor="#1A1A1A"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#7C4DFF"
                app:hintTextColor="#9E9E9E"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text|textCapCharacters"
                    android:paddingVertical="16dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitAnswer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="CONFIRM ANSWER"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                app:backgroundTint="#7C4DFF"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PANEL: STAGE 3  — Master Intelligence Challenge
         ══════════════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/panelStage3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLockedAppIcon3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Locked app icon"
                    tools:src="@android:drawable/sym_def_app_icon" />

                <TextView
                    android:id="@+id/tvLockedAppName3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:alpha="0.7"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    tools:text="Instagram is locked" />

                <ImageButton
                    android:id="@+id/btnClose3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#66FFFFFF" />
            </LinearLayout>

            <!-- Step progress (all 3 active) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_done" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_done" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_step_active" />
            </LinearLayout>

            <!-- Stage badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_stage3_badge"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="CHALLENGE III — MASTER INTELLIGENCE"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <!-- Timer -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="16dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/timerProgress3"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    app:indicatorColor="#FFD700"
                    app:trackColor="#2A2A2A"
                    app:trackThickness="5dp"
                    app:indicatorSize="72dp" />

                <TextView
                    android:id="@+id/tvTimer3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="90" />
            </FrameLayout>

            <!-- Recap cards: your answers -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="YOUR PREVIOUS ANSWERS:"
                android:textColor="#888888"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#140E2A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#3D2D6B"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHALLENGE I"
                            android:textColor="#7C4DFF"
                            android:textSize="9sp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tvRecapAnswer1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            tools:text="5" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#140E2A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#3D2D6B"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHALLENGE II"
                            android:textColor="#7C4DFF"
                            android:textSize="9sp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tvRecapAnswer2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            tools:text="196" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Master question card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1A1400"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#4A3900"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIDDEN RELATIONSHIP"
                        android:textColor="#FFD700"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvMasterQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="#EEEEEE"
                        android:textSize="15sp"
                        tools:text="What hidden relationship do these two answers share?" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wrong answer feedback (stage 3) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWrong3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1A0808"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#5C1010"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvWrongFeedback3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="14dp"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    tools:text="✗ Incorrect. 1 attempt remaining." />
            </com.google.android.material.card.MaterialCardView>

            <!-- 6 Option buttons (generated dynamically in code) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="SELECT THE CORRECT RELATIONSHIP:"
                android:textColor="#888888"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:id="@+id/llOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PANEL: LOCKED OUT
         ══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/panelLockedOut"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="INTELLIGENCE LOCKOUT"
            android:textColor="#FF5252"
            android:textSize="20sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvLockoutMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            tools:text="You failed the IQ challenge. This app is locked for 5 minutes.\n\nRethink your reasoning strategy before the next attempt." />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#2A2A2A"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNLOCKS IN"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvLockoutCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FF5252"
                    android:textSize="36sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="4:58" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PANEL: SOLVED (Success)
         ══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/panelSolved"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠"
            android:textSize="72sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="INTELLIGENCE CONFIRMED"
            android:textColor="#7C4DFF"
            android:textSize="22sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvSolvedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            tools:text="You solved all three stages.\nAccess granted." />

        <!-- Explanation card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="#140E2A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#3D2D6B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THE HIDDEN RELATIONSHIP"
                    android:textColor="#7C4DFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/tvExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.4"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"
                    tools:text="Both values are prime numbers." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenApp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="OPEN APP"
            android:textSize="15sp"
            app:backgroundTint="#7C4DFF"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         LOADING spinner (shown while ViewModel initialises)
         ══════════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible"
        app:indicatorColor="#7C4DFF"
        app:trackColor="#1A1A1A" />

</FrameLayout>

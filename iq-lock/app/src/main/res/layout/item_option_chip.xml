<?xml version="1.0" encoding="utf-8"?>
<!--
    item_option_chip.xml — Inflated for each multiple-choice answer option
    in LockScreenActivity. Hosted inside the ChipGroup.
-->
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/chip_height"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurface"
    app:chipBackgroundColor="?attr/colorSurfaceVariant"
    app:chipCornerRadius="@dimen/chip_corner_radius"
    app:chipStrokeColor="?attr/colorPrimary"
    app:chipStrokeWidth="1dp"
    app:rippleColor="?attr/colorPrimary" />

<?xml version="1.0" encoding="utf-8"?>
<!--
    accessibility_service_config.xml — Configures IQLockAccessibilityService.
    KEY SETTINGS:
      - accessibilityEventTypes: TYPE_WINDOW_STATE_CHANGED fires when any app comes to foreground.
      - feedbackType: FEEDBACK_GENERIC is required for services that don't provide spoken feedback.
      - flags: FLAG_REPORT_VIEW_IDS allows the service to inspect view IDs.
      - notificationTimeout: 100ms polling interval (lower = faster detection).
      - canRetrieveWindowContent: enables reading window content for better detection.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity=".ui.SettingsActivity" />
